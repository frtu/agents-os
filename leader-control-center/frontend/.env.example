# Use the in-browser mock backend (true) or a real FastAPI backend (false).
VITE_USE_MOCKS=true

# Base URL for REST + WebSocket when VITE_USE_MOCKS=false.
# Requests to /api are proxied to this target by vite in dev.
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/api/v1/stream

# Local leader-assistant REST service used by the story-drafting chat.
# In dev, "/assistant" is proxied to http://localhost:7860 by vite.
# Set to an absolute URL (e.g. http://localhost:7860) to bypass the proxy.
VITE_ASSISTANT_URL=/assistant
