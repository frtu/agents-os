# Local config template. Copy to backend/.env (gitignored) and edit there:
#   cp .env.example .env
# ../start.sh loads backend/.env; shell env vars and CLI flags override it.

# Host/port the API binds to. start.sh points the vite dev proxy at PORT.
HOST=0.0.0.0
PORT=8010

# Frontend (vite) dev server port, used by start.sh.
FRONTEND_PORT=5173

# Set to 1 to also start Temporal (../_infra_/docker-temporal) from start.sh.
WITH_TEMPORAL=0

# SQLite database file. Lives in the project-root data/ dir (../data/ from
# backend/); the directory is created on startup. See storage.md.
SQLITE_PATH=../data/leader-control-center.db

# Seconds between simulation ticks (running executions advance, raise requests,
# produce artifacts). Set to 0 to disable the background simulation.
SIMULATION_TICK_SECONDS=2.5

# Comma-separated allowed CORS origins for the browser app. Leave unset to let
# start.sh derive it from FRONTEND_PORT.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
