# Host/port the API binds to. The frontend's vite dev proxy targets :8000.
HOST=0.0.0.0
PORT=8000

# Seconds between simulation ticks (running executions advance, raise requests,
# produce artifacts). Set to 0 to disable the background simulation.
SIMULATION_TICK_SECONDS=2.5

# Comma-separated allowed CORS origins for the browser app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
