# Leader Assistant environment configuration
# See getting-started.md for full documentation

# Root folder holding Workspaces/<name>/ (relative to where you start the app, or an
# absolute path). This is the default; override by editing here or exporting the var in
# your shell (a shell/CLI value wins over .env).
LEADER_WORKSPACE_ROOT=./Workspaces

# Skills library location (relative to project root)
LEADER_SKILLS_SOURCE=../skills

# Global safety gate (spec 013). `true` (the default) enforces the maker-checker approval gate.
# Set to `false` to skip EVERY approval card and LLM risk check: the checker is never consulted
# and gating operations are granted directly. Operations are still scored, appended to log.md and
# git-committed - the ask is bypassed, the audit is not.
# Operator-only: read from the environment, with no REST route and no agent tool (spec 013 FR-4).
LEADER_CONTROL_MODE=true

# Langfuse API keys (for logging LLM calls)
# LANGFUSE_SECRET_KEY="sk-xx"
# LANGFUSE_PUBLIC_KEY="pk-xx"
# LANGFUSE_BASE_URL="http://localhost:3000"
