# transcribe-pdf — example configuration. Placeholders only: never put real values in this file.
#
# Every key is read from the environment. Optionally, put them in a private file that
# transcribe-pdf.sh loads before each run (a variable already set in your shell wins):
#
#   mkdir -p ~/.config/transcribe-pdf
#   cp <skills-dir>/transcribe-pdf/references/.env.example ~/.config/transcribe-pdf/.env
#   chmod 600 ~/.config/transcribe-pdf/.env      # then edit the values
#
# Format: KEY=VALUE, one per line; quotes optional; only TRANSCRIBE_PDF_* keys are loaded.
# Explicit override for one run: --password on the command line, or tell the agent the value.

# Secret: password tried on encrypted PDFs (in addition to the empty owner password).
TRANSCRIBE_PDF_PASSWORD=change-me

# Optional settings (defaults shown). Uncomment to change.
# TRANSCRIBE_PDF_VENV=~/.cache/transcribe-pdf/venv
# TRANSCRIBE_PDF_CACHE=~/.cache/transcribe-pdf
# TRANSCRIBE_PDF_PYTHON=python3
