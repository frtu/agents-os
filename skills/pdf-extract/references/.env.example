# pdf-extract — example configuration. Placeholders only: never put real values in this file.
#
# Every key is read from the environment. Optionally, put them in a private file that
# pdf-extract.sh loads before each run (a variable already set in your shell wins):
#
#   mkdir -p ~/.config/pdf-extract
#   cp <skills-dir>/pdf-extract/references/.env.example ~/.config/pdf-extract/.env
#   chmod 600 ~/.config/pdf-extract/.env      # then edit the values
#
# Format: KEY=VALUE, one per line; quotes optional; only PDF_EXTRACT_* keys are loaded.
# Explicit override for one run: --password on the command line, or tell the agent the value.

# Secret: password tried on encrypted PDFs (in addition to the empty owner password).
PDF_EXTRACT_PASSWORD=change-me

# Optional settings (defaults shown). Uncomment to change.
# PDF_EXTRACT_VENV=~/.cache/pdf-extract/venv
# PDF_EXTRACT_CACHE=~/.cache/pdf-extract
# PDF_EXTRACT_PYTHON=python3
